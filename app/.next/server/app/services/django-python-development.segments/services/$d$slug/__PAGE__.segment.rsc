16:["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Outman Elbouhali - Full Stack Web & Mobile App Developer\",\"url\":\"https://www.outmanelbouhali.online\",\"image\":\"https://www.outmanelbouhali.online/images/icon.png\",\"email\":\"outmanelbouhali5@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Tétouan\",\"addressCountry\":\"Morocco\"}}"}}]

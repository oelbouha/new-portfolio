37:["$","div","Can you work with my existing design files or wireframes?",{"className":"p-6 sm:p-8 rounded-[4px] border border-black/10 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]","children":[["$","h3",null,{"className":"font-['PP_Neue_Corp_Tight_Ultrabold'] text-xl sm:text-2xl uppercase tracking-[0.06em] leading-snug mb-3","children":"Can you work with my existing design files or wireframes?"}],["$","p",null,{"className":"font-['Space_Grotesk'] text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed","children":"Absolutely. If you have Figma, Sketch, or Adobe XD mockups, I translate them with obsessive attention to spacing, hierarchy, and micro-interactions. If you only have wireframes or product specs, I provide website design services and interactive UI layouts tailored to your brand."}]]}]

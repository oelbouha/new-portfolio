1c:T9f4,{"@context":"https://schema.org","@type":"Service","serviceType":"WordPress Theme Development Service & CMS Solutions","name":"WordPress Theme Development Service & CMS Solutions","description":"Custom WordPress theme development service for content platforms, publishers, and businesses. Fast, clean, SEO-optimized WordPress code without bloated plugins.","provider":{"@type":"Person","name":"Outman Elbouhali","url":"https://www.outmanelbouhali.online"},"areaServed":"Worldwide","hasOfferCatalog":{"@type":"OfferCatalog","name":"Custom WordPress & CMS Engineering Deliverables","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Bespoke WordPress Theme Development","description":"Handcrafted, clean PHP/TypeScript WordPress themes engineered from scratch without bloated generic parent themes. Fully modular templates following modern WordPress coding standards and semantic HTML5 hierarchy."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"WordPress Speed Optimization & Core Web Vitals","description":"Drastic latency reductions: database query minimization, critical CSS inlining, native image lazy-loading, WebP conversion, Redis object caching, and achieving 95+ Google PageSpeed Insights mobile scores."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Advanced Custom Fields (ACF Pro) & Custom Post Types","description":"Structured back-office publishing interfaces configured with ACF Pro and Gutenberg blocks. Content editors can create rich, customized landing pages effortlessly without breaking layout consistency."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Technical SEO Infrastructure & Rich Schema Markup","description":"Automated OpenGraph meta generators, dynamic XML sitemaps, breadcrumbs, canonical tag rules, and JSON-LD structured schemas (Article, Recipe, Organization, FAQPage) engineered directly into template files."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Elementor Expert & Page Builder Customization","description":"When visual flexibility is mandatory, I build custom lightweight Elementor widgets and dynamic template systems that empower marketing teams while preserving strict page performance benchmarks."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Search Indexing & Social Automation Pipelines","description":"Automated webhook triggers that notify Google Search Console and Bing Webmaster Tools instantly upon post publication, coupled with automatic branded card generation for social distribution."}}]}}11:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Outman Elbouhali - Full Stack Web & Mobile App Developer\",\"url\":\"https://www.outmanelbouhali.online\",\"image\":\"https://www.outmanelbouhali.online/images/icon.png\",\"email\":\"outmanelbouhali5@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Tétouan\",\"addressCountry\":\"Morocco\"}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://www.outmanelbouhali.online/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"WordPress Theme Development Service & CMS Solutions\",\"item\":\"https://www.outmanelbouhali.online/services/wordpress-development\"}]}"}}],"$L1d"],"$L1e"]

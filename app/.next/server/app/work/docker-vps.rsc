11:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Docker VPS\",\"headline\":\"VPS container orchestration & CI/CD deployment.\",\"description\":\"Designed and deployed a resilient server infrastructure on a Linux VPS. Isolated services into lightweight Docker containers, configured multi-domain SSL with Let’s Encrypt, and orchestrated automated zero-downtime deployment pipelines with GitHub Actions.\",\"applicationCategory\":\"Cloud & Infrastructure\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/docker.jpeg\",\"url\":\"https://www.outmanelbouhali.online/work/docker-vps\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Docker VPS\",\"item\":\"https://www.outmanelbouhali.online/work/docker-vps\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"docker-vps","title":"Docker VPS","category":"Cloud & Infrastructure","year":"2025","tagline":"VPS container orchestration & CI/CD deployment.","description":"Production VPS orchestration system leveraging Docker containers, NGINX reverse proxy, automated SSL certificates, and streamlined CI/CD flows.","overview":"Designed and deployed a resilient server infrastructure on a Linux VPS. Isolated services into lightweight Docker containers, configured multi-domain SSL with Let’s Encrypt, and orchestrated automated zero-downtime deployment pipelines with GitHub Actions.","conclusion":"Established high availability, sub-100ms response times, and automated container lifecycle management across production servers.","thumbnail":{"src":"/images/docker.jpeg","alt":"Docker VPS server orchestration preview"},"heroImage":{"src":"/images/docker.jpeg","alt":"Docker containers running in Linux terminal"},"coverImage":{"src":"/images/docker.jpeg","alt":"Linux VPS and NGINX configuration setup"},"images":[{"src":"/images/docker.jpeg","alt":"Docker compose multi-container orchestration"},{"src":"/images/docker1.png","alt":"Docker production containers status"},{"src":"/images/docker2.webp","alt":"NGINX reverse proxy and SSL certificate deployment"},{"src":"/images/docker5.png","alt":"Automated CI/CD deployment logs"}],"services":["Docker Containerization","VPS Hardening","NGINX Reverse Proxy","CI/CD Pipelines"],"client":"Cloud Infrastructure","website":"","tags":["Docker","Linux VPS","NGINX","DevOps","CI/CD"],"serviceSlugs":["django-python-development","n8n-automation"],"link":"","quote":"Robust server hardening and container orchestration that cut deployment friction to zero.","quoteAuthor":"DevOps Architecture","quoteRole":"Infrastructure Highlights","credits":[{"role":"DevOps Engineering","name":"Outman El Bouhali"},{"role":"System Administration","name":"Outman El Bouhali"}]},"nextProject":{"slug":"webserv","title":"Webserv","category":"Systems Programming","year":"2024","tagline":"Custom C++ HTTP/1.1 web server from scratch.","description":"Non-blocking I/O multiplexed HTTP/1.1 web server written in C++98 handling concurrent connections, CGI execution, and route management.","overview":"Developed a fully compliant HTTP/1.1 web server from scratch in C++ without external libraries. Built using poll/epoll socket multiplexing to handle hundreds of concurrent clients simultaneously with non-blocking I/O, custom NGINX-style configuration parsing, static file streaming, and dynamic CGI support.","conclusion":"Achieved strict RFC compliance, zero memory leaks, and high-throughput network performance verified through rigorous stress testing.","thumbnail":{"src":"/images/webserv.png","alt":"Webserv custom C++ HTTP server terminal preview"},"heroImage":{"src":"/images/webserv.png","alt":"Webserv architecture socket multiplexing diagram"},"coverImage":{"src":"/images/webserv.png","alt":"Webserv server configuration parser showcase"},"images":[{"src":"/images/webserv.png","alt":"Webserv terminal execution output"},{"src":"/images/webserv2.png","alt":"Webserv concurrent client stress test results"},{"src":"/images/webserv1.avif","alt":"Webserv CGI environment handling demonstration"}],"services":["Systems Programming","C++ Network Architecture","HTTP/1.1 Protocol Engine","CGI Execution Layer"],"client":"42 Network / Systems Project","website":"https://github.com/oelbouha/webserv","tags":["C++","HTTP/1.1","Sockets","Network Systems","epoll"],"serviceSlugs":["django-python-development","web-application-development"],"link":"https://github.com/oelbouha/webserv","quote":"A deeply engineered socket server with meticulous state machines and asynchronous I/O multiplexing.","quoteAuthor":"Systems Review","quoteRole":"Core Network Engineering","credits":[{"role":"Lead Systems Developer","name":"Outman El Bouhali"}]}}]]

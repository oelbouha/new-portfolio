10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Habivio\",\"headline\":\"Mobile habit tracker & wellness interface built for daily engagement.\",\"description\":\"Habivio is a mobile wellness platform designed to turn positive daily rituals into lasting habits. Featuring intuitive progress rings, streak analytics, and bespoke haptic feedback loops, the app provides a frictionless user experience that keeps users focused and motivated.\",\"applicationCategory\":\"Mobile UX & Product\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/habivio/habivio.png\",\"url\":\"https://www.outmanelbouhali.online/work/habivio\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Habivio\",\"item\":\"https://www.outmanelbouhali.online/work/habivio\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"habivio","title":"Habivio","category":"Mobile UX & Product","year":"2025","tagline":"Mobile habit tracker & wellness interface built for daily engagement.","description":"A sleek habit tracking and personal wellness iOS & Android app built with React Native and modern micro-interactions.","overview":"Habivio is a mobile wellness platform designed to turn positive daily rituals into lasting habits. Featuring intuitive progress rings, streak analytics, and bespoke haptic feedback loops, the app provides a frictionless user experience that keeps users focused and motivated.","conclusion":"Engineered a polished cross-platform mobile application combining real-time progress visualization, offline-first data synchronization, and delightful micro-interactions.","thumbnail":{"src":"/images/habivio/habivio.png","alt":"Habivio project thumbnail"},"heroImage":{"src":"/images/habivio/habivio.png","alt":"Habivio project hero preview"},"coverImage":{"src":"/images/habivio/habivio.png","alt":"Habivio project showcase"},"images":[{"src":"/images/habivio/habivio.png","alt":"Habivio project showcase image 1"},{"src":"/images/habivio/habivio 1.png","alt":"Habivio project showcase image 2"},{"src":"/images/habivio/habivio 2.png","alt":"Habivio project showcase image 3"},{"src":"/images/habivio/habivio 3.png","alt":"Habivio project showcase image 4"}],"services":["Mobile Product Design","React Native Development","UX Interaction Architecture","Local Storage & Sync"],"serviceSlugs":["flutter-app-development"],"client":"Habivio Wellness","website":"","tags":["Mobile UX","React Native","TypeScript","Wellness"],"link":"","quote":"A masterclass in minimal, friction-free mobile product engineering with high-touch tactile feedback.","quoteAuthor":"Product Review","quoteRole":"Mobile UX & Interaction Design"},"nextProject":{"slug":"saladly","title":"Saladly","category":"WordPress & Automation","year":"2026","tagline":"A custom WordPress recipe platform built for SEO, content publishing, and automation.","description":"A freelance WordPress project involving custom website development, SEO infrastructure, search engine integrations, social media automation, and automated indexing workflows.","overview":"Saladly is a custom WordPress website developed as a freelance project for a recipe and food content platform. I built and customized the WordPress website, developed the content structure for recipes and blog posts, organized the recipe categories, and implemented the website architecture around SEO and content discoverability. The project also included Google Search Console and Bing Webmaster Tools integration, automated social media publishing for new content, and automated workflows for requesting search engine indexing when new recipes and blog posts are published.","conclusion":"Delivered a complete WordPress content platform combining custom development, SEO infrastructure, search engine integrations, social media automation, and automated indexing workflows.","thumbnail":{"src":"/images/salad/daily salad recipes.png","alt":"Saladly project thumbnail"},"heroImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly project hero preview"},"coverImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly project showcase"},"images":[{"src":"/images/salad/salad recipes.png","alt":"Saladly project showcase image 1"},{"src":"/images/salad/salad recipes 1.png","alt":"Saladly project showcase image 2"},{"src":"/images/salad/salad recipes 2.png","alt":"Saladly project showcase image 3"}],"services":["WordPress Development","Custom Theme Development","SEO Implementation","Google Search Console Integration","Bing Webmaster Tools Integration","Social Media Automation","Search Indexing Automation"],"serviceSlugs":["wordpress-development","n8n-automation"],"client":"Daily Salad Recipes","website":"https://dailysaladrecipes.com/","tags":["WordPress","PHP","SEO","Google Search Console","Bing Webmaster Tools","Make.com","Automation","Social Media"],"link":"https://dailysaladrecipes.com/","quote":"A custom WordPress platform combining structured content, SEO infrastructure, automated social publishing, and search indexing workflows.","quoteAuthor":"Daily Salad Recipes","quoteRole":"Freelance Web Development"}}]]

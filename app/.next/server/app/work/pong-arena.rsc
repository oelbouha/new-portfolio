10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Pong Arena\",\"headline\":\"Real-time multiplayer gaming built for the web.\",\"description\":\"Pong Arena is a full-stack multiplayer web application built with Django and JavaScript. The platform combines a Django backend with a dynamic JavaScript frontend, using WebSockets to enable real-time multiplayer communication and gameplay. It also includes player management, matchmaking, and tournament functionality.\",\"applicationCategory\":\"Full Stack Web App\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/pong/Create_a_mockup_2k_202602141753.jpeg\",\"url\":\"https://github.com/oelbouha/ft_transcendence\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Pong Arena\",\"item\":\"https://www.outmanelbouhali.online/work/pong-arena\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"pong-arena","title":"Pong Arena","category":"Full Stack Web App","year":"2024","tagline":"Real-time multiplayer gaming built for the web.","description":"A full-stack multiplayer gaming platform built with Django and JavaScript, featuring real-time gameplay, WebSockets, and tournament management.","overview":"Pong Arena is a full-stack multiplayer web application built with Django and JavaScript. The platform combines a Django backend with a dynamic JavaScript frontend, using WebSockets to enable real-time multiplayer communication and gameplay. It also includes player management, matchmaking, and tournament functionality.","conclusion":"Built and delivered a complete real-time multiplayer platform, combining backend architecture, WebSocket communication, interactive game logic, and responsive frontend experiences.","thumbnail":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena project thumbnail"},"heroImage":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena project hero preview"},"coverImage":{"src":"/images/pong/Create_a_mockup_2k_202602141753.jpeg","alt":"Pong Arena project showcase"},"images":[{"src":"/images/pong/pongarena1.jpeg","alt":"Pong Arena project showcase image 1"},{"src":"/images/pong/pongarena1.jpeg","alt":"Pong Arena project showcase image 2"},{"src":"/images/pong/Create_a_mockup_2k_202602141751.jpeg","alt":"Pong Arena project showcase image 3"}],"services":["Full Stack Development","Django Backend","JavaScript Frontend","WebSocket Architecture"],"serviceSlugs":["django-python-development","web-application-development"],"client":"42 Network / Open Source","website":"https://github.com/oelbouha/ft_transcendence","tags":["Django","JavaScript","WebSockets","Full Stack"],"link":"https://github.com/oelbouha/ft_transcendence","quote":"A complete real-time multiplayer experience combining solid backend architecture with responsive gameplay.","quoteAuthor":"42 Network","quoteRole":"Open Source Community"},"nextProject":{"slug":"habivio","title":"Habivio","category":"Mobile UX & Product","year":"2025","tagline":"Mobile habit tracker & wellness interface built for daily engagement.","description":"A sleek habit tracking and personal wellness iOS & Android app built with React Native and modern micro-interactions.","overview":"Habivio is a mobile wellness platform designed to turn positive daily rituals into lasting habits. Featuring intuitive progress rings, streak analytics, and bespoke haptic feedback loops, the app provides a frictionless user experience that keeps users focused and motivated.","conclusion":"Engineered a polished cross-platform mobile application combining real-time progress visualization, offline-first data synchronization, and delightful micro-interactions.","thumbnail":{"src":"/images/habivio/habivio.png","alt":"Habivio project thumbnail"},"heroImage":{"src":"/images/habivio/habivio.png","alt":"Habivio project hero preview"},"coverImage":{"src":"/images/habivio/habivio.png","alt":"Habivio project showcase"},"images":[{"src":"/images/habivio/habivio.png","alt":"Habivio project showcase image 1"},{"src":"/images/habivio/habivio 1.png","alt":"Habivio project showcase image 2"},{"src":"/images/habivio/habivio 2.png","alt":"Habivio project showcase image 3"},{"src":"/images/habivio/habivio 3.png","alt":"Habivio project showcase image 4"}],"services":["Mobile Product Design","React Native Development","UX Interaction Architecture","Local Storage & Sync"],"serviceSlugs":["flutter-app-development"],"client":"Habivio Wellness","website":"","tags":["Mobile UX","React Native","TypeScript","Wellness"],"link":"","quote":"A masterclass in minimal, friction-free mobile product engineering with high-touch tactile feedback.","quoteAuthor":"Product Review","quoteRole":"Mobile UX & Interaction Design"}}]]

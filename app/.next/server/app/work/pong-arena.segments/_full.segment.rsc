11:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Pong Arena\",\"headline\":\"Real-time multiplayer gaming built for the web.\",\"description\":\"Pong Arena is a full-stack multiplayer web application built with Django and JavaScript. The platform combines a Django backend with a dynamic JavaScript frontend, using WebSockets to enable real-time multiplayer communication and gameplay. It also includes player management, matchmaking, and tournament functionality.\",\"applicationCategory\":\"Full Stack Web App\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/pong/Create_a_mockup_2k_202602141753.jpeg\",\"url\":\"https://github.com/oelbouha/ft_transcendence\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Pong Arena\",\"item\":\"https://www.outmanelbouhali.online/work/pong-arena\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"pong-arena","title":"Pong Arena","category":"Full Stack Web App","year":"2024","tagline":"Real-time multiplayer gaming built for the web.","description":"A full-stack multiplayer gaming platform built with Django and JavaScript, featuring real-time gameplay, WebSockets, and tournament management.","overview":"Pong Arena is a full-stack multiplayer web application built with Django and JavaScript. The platform combines a Django backend with a dynamic JavaScript frontend, using WebSockets to enable real-time multiplayer communication and gameplay. It also includes player management, matchmaking, and tournament functionality.","conclusion":"Built and delivered a complete real-time multiplayer platform, combining backend architecture, WebSocket communication, interactive game logic, and responsive frontend experiences.","thumbnail":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena multiplayer game preview"},"heroImage":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena real-time WebSocket match showcase"},"coverImage":{"src":"/images/pong/Create_a_mockup_2k_202602141753.jpeg","alt":"Pong Arena device mockups"},"images":[{"src":"/images/pong/pongarena1.jpeg","alt":"Pong Arena tournament lobby screen"},{"src":"/images/pong/Create_a_mockup_2k_202602141751.jpeg","alt":"Pong Arena live gameplay screen"}],"services":["Full Stack Development","Django Backend","JavaScript Frontend","WebSocket Architecture"],"client":"42 Network / Open Source","website":"https://github.com/oelbouha/ft_transcendence","tags":["Django","JavaScript","WebSockets","Full Stack"],"serviceSlugs":["django-python-development","web-application-development"],"link":"https://github.com/oelbouha/ft_transcendence","quote":"A complete real-time multiplayer experience combining solid backend architecture with responsive gameplay.","quoteAuthor":"42 Network","quoteRole":"Open Source Community","credits":[{"role":"Full Stack Development","name":"Outman El Bouha"},{"role":"Real-Time Architecture","name":"Outman El Bouha"},{"role":"Game Development","name":"Outman El Bouha"}]},"nextProject":{"slug":"habivio","title":"Habivio","category":"Mobile UX & Product","year":"2025","tagline":"Mobile habit tracker & wellness interface built for daily engagement.","description":"A sleek habit tracking and personal wellness mobile application built with cross-platform architecture, fluid gestures, and modern micro-interactions.","overview":"Habivio is a mobile wellness platform designed to turn positive daily rituals into lasting habits. Featuring intuitive progress rings, streak analytics, and bespoke haptic feedback loops, the app provides a frictionless user experience that keeps users focused and motivated.","conclusion":"Engineered a polished cross-platform mobile application combining real-time progress visualization, offline-first data synchronization, and delightful micro-interactions.","thumbnail":{"src":"/images/habivio/habivio.png","alt":"Habivio wellness habit mobile interface"},"heroImage":{"src":"/images/habivio/habivio.png","alt":"Habivio mobile app daily dashboard screen"},"coverImage":{"src":"/images/habivio/habivio.png","alt":"Habivio habit analytics and progress tracking view"},"images":[{"src":"/images/habivio/habivio.png","alt":"Habivio streak tracking ring showcase"},{"src":"/images/habivio/habivio 1.png","alt":"Habivio morning checklist interface"},{"src":"/images/habivio/habivio 2.png","alt":"Habivio weekly performance charts"},{"src":"/images/habivio/habivio 3.png","alt":"Habivio settings and profile customization"}],"services":["Mobile Product Design","Mobile App Development","UX Interaction Architecture","Local Storage & Sync"],"client":"Habivio Wellness","website":"","tags":["Mobile UX","Mobile App","TypeScript","Wellness"],"serviceSlugs":["flutter-app-development"],"link":"","quote":"A minimal, friction-free mobile product engineering with high-touch tactile feedback.","quoteAuthor":"Product Review","quoteRole":"Mobile UX & Interaction Design","credits":[{"role":"Mobile App Development","name":"Outman El Bouhali"},{"role":"UI/UX Design","name":"Outman El Bouhali"}]}}]]

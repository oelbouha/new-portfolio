10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"QuickDrop\",\"headline\":\"A Flutter marketplace connecting senders with travelers for package delivery.\",\"description\":\"QuickDrop is a cross-platform mobile application that connects people who need to ship packages with travelers moving along the same route. Senders can create shipment listings, while couriers can publish trips, manage deliveries, and earn money along their routes. The platform includes Google authentication, Firebase-backed user and shipment management, in-app messaging, real-time status tracking, push notifications, ratings, and secure Stripe payments.\",\"applicationCategory\":\"Peer-to-Peer Mobile Application\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/quickdrop/quickdrop1.jpeg\",\"url\":\"https://www.outmanelbouhali.online/work/quickdrop\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"QuickDrop\",\"item\":\"https://www.outmanelbouhali.online/work/quickdrop\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"quickdrop","title":"QuickDrop","category":"Peer-to-Peer Mobile Application","year":"2025","tagline":"A Flutter marketplace connecting senders with travelers for package delivery.","description":"A peer-to-peer package delivery mobile application built with Flutter and Firebase, connecting senders with travelers through secure payments, messaging, and real-time delivery updates.","overview":"QuickDrop is a cross-platform mobile application that connects people who need to ship packages with travelers moving along the same route. Senders can create shipment listings, while couriers can publish trips, manage deliveries, and earn money along their routes. The platform includes Google authentication, Firebase-backed user and shipment management, in-app messaging, real-time status tracking, push notifications, ratings, and secure Stripe payments.","conclusion":"Delivered a complete peer-to-peer delivery platform combining mobile product design, Firebase services, real-time communication, push notifications, and secure payment processing.","thumbnail":{"src":"/images/quickdrop/quickdrop.jpeg","alt":"QuickDrop project thumbnail"},"heroImage":{"src":"/images/quickdrop/quickdrop1.jpeg","alt":"QuickDrop project hero preview"},"coverImage":{"src":"/images/quickdrop/quickdrop1.jpeg","alt":"QuickDrop project showcase"},"images":[{"src":"/images/quickdrop/quickdrop.jpeg","alt":"QuickDrop project showcase image 1"},{"src":"/images/quickdrop/quickdrop1.jpeg","alt":"QuickDrop project showcase image 2"},{"src":"/images/quickdrop/quickdrop2.jpeg","alt":"QuickDrop project showcase image 3"},{"src":"/images/quickdrop/quickdrop3.jpeg","alt":"QuickDrop project showcase image 4"},{"src":"/images/quickdrop/quickdrop4.jpeg","alt":"QuickDrop project showcase image 5"}],"services":["Flutter Mobile Development","Firebase Authentication","Cloud Firestore & Storage","Google Sign-In","Push Notifications","Stripe Payment Integration","Real-Time Messaging & Tracking"],"serviceSlugs":["flutter-app-development"],"client":"QuickDrop","website":"","tags":["Flutter","Dart","Firebase","Google Sign-In","Cloud Firestore","Firebase Messaging","Stripe","Peer-to-Peer Delivery"],"link":"https://github.com/oelbouha/quickdrop","quote":"A connected delivery marketplace that turns everyday travel routes into a reliable way to move packages between people.","quoteAuthor":"Project Highlights","quoteRole":"Mobile Product Development"},"nextProject":{"slug":"skatys","title":"Skatys","category":"Full-Stack Corporate Website","year":"2026","tagline":"A modern digital presence for an SAP and digital transformation company.","description":"A full-stack corporate website developed for SKATYS Inc., presenting the company, its expertise, SAP solutions, services, and industry insights through a modern digital experience.","overview":"SKATYS is a corporate web platform developed to establish and strengthen the company’s digital presence. The website presents the company’s identity, expertise, business solutions, and services while providing an Insights & News section for sharing industry knowledge and company updates. Built with Next.js and Django, the platform combines a modern frontend with a structured backend architecture, supported by PostgreSQL and Docker-based deployment on a production VPS.","conclusion":"Delivered a full-stack corporate website combining company presentation, business solution showcases, content sections, and production infrastructure.","thumbnail":{"src":"/images/skatys/skatys lab.png","alt":"Skatys project thumbnail"},"heroImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys project hero preview"},"coverImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys project showcase"},"images":[{"src":"/images/skatys/skatys website .png","alt":"Skatys project showcase image 1"},{"src":"/images/skatys/skatys website.png","alt":"Skatys project showcase image 2"},{"src":"/images/skatys/skatys website mobile 3.png","alt":"Skatys project showcase image 3"},{"src":"/images/skatys/skatys website mobile 1.png","alt":"Skatys project showcase image 4"}],"services":["Corporate Website Development","Full-Stack Development","Next.js Frontend","Django Backend & API","Content & Insights Presentation","Docker VPS Deployment"],"serviceSlugs":["web-application-development","django-python-development"],"client":"Skatys Inc.","website":"https://skatys.com/","tags":["Next.js","Django","Python","PostgreSQL","Docker","Corporate Website","Full Stack"],"link":"https://skatys.com/","quote":"A modern corporate digital platform connecting company information, business solutions, and industry insights through a full-stack architecture.","quoteAuthor":"Project Highlights","quoteRole":"Full-Stack Development"}}]]

10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Revo Advertising\",\"headline\":\"A digital portfolio showcasing the creative identity of Revo Advertising.\",\"description\":\"Revo Advertising is a portfolio website created to establish the agency’s online presence and showcase its brand identity, creative capabilities, and services. Developed with React.js, the website focuses on presenting the agency professionally through a modern interface, structured content, reusable components, and responsive layouts optimized for different devices.\",\"applicationCategory\":\"Agency Portfolio Website\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/revo/revo4.jpeg\",\"url\":\"https://revo.com\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Revo Advertising\",\"item\":\"https://www.outmanelbouhali.online/work/revo\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"revo","title":"Revo Advertising","category":"Agency Portfolio Website","year":"2025","tagline":"A digital portfolio showcasing the creative identity of Revo Advertising.","description":"A modern React-based agency portfolio website developed for Revo Advertising, presenting the agency’s identity, creative work, and professional services through a responsive digital experience.","overview":"Revo Advertising is a portfolio website created to establish the agency’s online presence and showcase its brand identity, creative capabilities, and services. Developed with React.js, the website focuses on presenting the agency professionally through a modern interface, structured content, reusable components, and responsive layouts optimized for different devices.","conclusion":"Delivered a modern agency portfolio website that communicates Revo Advertising’s identity and presents its creative work and services through a responsive React experience.","thumbnail":{"src":"/images/revo/revo lab.png","alt":"Revo Advertising project thumbnail"},"heroImage":{"src":"/images/revo/revo thumbnail.jpeg","alt":"Revo Advertising project hero preview"},"coverImage":{"src":"/images/revo/revo4.jpeg","alt":"Revo Advertising project showcase"},"images":[{"src":"/images/revo/revo.jpeg","alt":"Revo Advertising project showcase image 1"},{"src":"/images/revo/revoo.jpeg","alt":"Revo Advertising project showcase image 2"}],"services":["Agency Portfolio Development","React.js Development","Frontend Architecture","Creative Work Presentation","Responsive Web Design","UI/UX Implementation"],"serviceSlugs":["web-application-development"],"client":"Revo Advertising","website":"https://revo.com","tags":["React.js","JavaScript","Agency Portfolio","Web Development","Responsive Design","UI/UX"],"link":"https://github.com/oelbouha/Revo","quote":"A professional digital portfolio designed to communicate an advertising agency’s identity, showcase its work, and present its services.","quoteAuthor":"Project Highlights","quoteRole":"Frontend Development"},"nextProject":{"slug":"pong-arena","title":"Pong Arena","category":"Full Stack Web App","year":"2024","tagline":"Real-time multiplayer gaming built for the web.","description":"A full-stack multiplayer gaming platform built with Django and JavaScript, featuring real-time gameplay, WebSockets, and tournament management.","overview":"Pong Arena is a full-stack multiplayer web application built with Django and JavaScript. The platform combines a Django backend with a dynamic JavaScript frontend, using WebSockets to enable real-time multiplayer communication and gameplay. It also includes player management, matchmaking, and tournament functionality.","conclusion":"Built and delivered a complete real-time multiplayer platform, combining backend architecture, WebSocket communication, interactive game logic, and responsive frontend experiences.","thumbnail":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena project thumbnail"},"heroImage":{"src":"/images/pong/pong thumbnail.jpeg","alt":"Pong Arena project hero preview"},"coverImage":{"src":"/images/pong/Create_a_mockup_2k_202602141753.jpeg","alt":"Pong Arena project showcase"},"images":[{"src":"/images/pong/pongarena1.jpeg","alt":"Pong Arena project showcase image 1"},{"src":"/images/pong/pongarena1.jpeg","alt":"Pong Arena project showcase image 2"},{"src":"/images/pong/Create_a_mockup_2k_202602141751.jpeg","alt":"Pong Arena project showcase image 3"}],"services":["Full Stack Development","Django Backend","JavaScript Frontend","WebSocket Architecture"],"serviceSlugs":["django-python-development","web-application-development"],"client":"42 Network / Open Source","website":"https://github.com/oelbouha/ft_transcendence","tags":["Django","JavaScript","WebSockets","Full Stack"],"link":"https://github.com/oelbouha/ft_transcendence","quote":"A complete real-time multiplayer experience combining solid backend architecture with responsive gameplay.","quoteAuthor":"42 Network","quoteRole":"Open Source Community"}}]]

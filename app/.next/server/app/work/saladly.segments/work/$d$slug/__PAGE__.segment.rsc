15:["$","$L37",null,{"project":{"slug":"saladly","title":"Saladly","category":"WordPress & Automation","year":"2026","tagline":"A custom WordPress recipe platform built for SEO, content publishing, and automation.","description":"A freelance WordPress project involving custom website development, SEO infrastructure, search engine integrations, social media automation, and automated indexing workflows.","overview":"Saladly is a custom WordPress website developed as a freelance project for a recipe and food content platform. I built and customized the WordPress website, developed the content structure for recipes and blog posts, organized the recipe categories, and implemented the website architecture around SEO and content discoverability. The project also included Google Search Console and Bing Webmaster Tools integration, automated social media publishing for new content, and automated workflows for requesting search engine indexing when new recipes and blog posts are published.","conclusion":"Delivered a complete WordPress content platform combining custom development, SEO infrastructure, search engine integrations, social media automation, and automated indexing workflows.","thumbnail":{"src":"/images/salad/daily salad recipes.png","alt":"Saladly project thumbnail"},"heroImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly project hero preview"},"coverImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly project showcase"},"images":[{"src":"/images/salad/salad recipes.png","alt":"Saladly project showcase image 1"},{"src":"/images/salad/salad recipes 1.png","alt":"Saladly project showcase image 2"},{"src":"/images/salad/salad recipes 2.png","alt":"Saladly project showcase image 3"}],"services":["WordPress Development","Custom Theme Development","SEO Implementation","Google Search Console Integration","Bing Webmaster Tools Integration","Social Media Automation","Search Indexing Automation"],"serviceSlugs":["wordpress-development","n8n-automation"
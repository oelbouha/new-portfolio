15:["$","$L2b",null,{"project":{"slug":"saladly","title":"Saladly","category":"WordPress & Automation","year":"2026","tagline":"A custom WordPress recipe platform built for SEO, content publishing, and automation.","description":"A custom WordPress platform featuring tailored theme engineering, technical SEO infrastructure, search indexing, and automated social workflows.","overview":"Saladly is a custom WordPress website developed as a freelance project for a recipe and food content platform. I built and customized the WordPress website, developed the content structure for recipes and blog posts, organized the recipe categories, and implemented the website architecture around SEO and content discoverability. The project also included Google Search Console and Bing Webmaster Tools integration, automated social media publishing for new content, and automated workflows for requesting search engine indexing when new recipes and blog posts are published.","conclusion":"Delivered a complete WordPress content platform combining custom development, SEO infrastructure, search engine integrations, social media automation, and automated indexing workflows.","thumbnail":{"src":"/images/salad/daily salad recipes.png","alt":"Saladly food recipe WordPress platform"},"heroImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly custom theme desktop homepage"},"coverImage":{"src":"/images/salad/salad recipes.png","alt":"Saladly SEO-optimized recipe article layout"},"images":[{"src":"/images/salad/salad recipes.png","alt":"Saladly recipe listing catalog"},{"src":"/images/salad/salad recipes 1.png","alt":"Saladly structured recipe schema and ingredients view"},{"src":"/images/salad/salad recipes 2.png","alt":"Saladly automated social card generator preview"}],"services":["WordPress Development","Custom Theme Development","SEO Implementation","Google Search Console Integration","Bing Webmaster Tools Integration","Social Media Automation","Search Indexing Automation"],"client":"Daily Salad Recipes","website":"https://dailysaladrecipes.com/","tags":["WordPress","PHP","SEO","Google Search Console","Bing Webmaster Tools","Make.com","Automation","Social Media"],"serviceSlugs":["wordpress-development","n8n-automation"],"link":"https://dailysaladrecipes.com/","quote":"A custom WordPress platform combining structured content, SEO infrastructure, automated social publishing, and search indexing workflows.","quoteAuthor":"Daily Salad Recipes","quoteRole":"Freelance Web Development","credits":[{"role":"WordPress Development","name":"Outman El Bouhali"},{"role":"Custom Theme Development","name":"Outman El Bouhali"},{"role":"SEO & Search Integration","name":"Outman El Bouhali"},{"role":"Automation & Integrations","name":"Outman El Bouhali"}]},"nextProject":{"slug":"workflow-automation","title":"Workflow Hub","category":"Automation Pipelines","year":"2025","tagline":"n8n & Make custom integration pipelines.","description":"An enterprise automation pipeline connecting multiple SaaS tools, webhooks, and AI agents for end-to-end operational workflow optimization.","overview":"Constructed scalable automation architectures using self-hosted n8n instances and Make. Built custom webhooks, data transformation scripts, error recovery loops, and AI-powered categorization pipelines to automate routine business workflows.","conclusion":"Saved hundreds of operational hours per month by bridging CRM, billing, messaging, and database updates seamlessly.","thumbnail":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n workflow hub orchestration preview"},"heroImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n automation canvas diagram showing multi-step API connectors"},"coverImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n visual node workflow execution graph"},"images":[{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n trigger and webhook integration nodes"},{"src":"/images/n8n/automation.png","alt":"Self-hosted n8n workflow execution logs"},{"src":"/images/n8n/automation .png","alt":"AI agent routing node and LLM integration in n8n"}],"services":["n8n Architecture","API & Webhook Integrations","Data Transformation","Workflow Optimization"],"client":"Internal & Client Systems","website":"","tags":["n8n","Automation","Webhooks","REST APIs","Pipelines"],"serviceSlugs":["n8n-automation"],"link":"","quote":"Turned complex multi-tool operational headaches into reliable, zero-touch background automation.","quoteAuthor":"Automation Engineering","quoteRole":"Integration Systems","credits":[{"role":"Automation Architect","name":"Outman El Bouhali"}]}}]

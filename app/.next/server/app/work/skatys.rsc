11:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Skatys\",\"headline\":\"The modern freelance marketplace built for speed.\",\"description\":\"Skatys is a custom-engineered web application combining a hyper-fast Next.js frontend with a robust Django REST backend. Deployed on a Linux VPS using Docker containers and NGINX reverse proxy for high security and performance.\",\"applicationCategory\":\"Full Stack Web App\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/skatys/Skatys Website .png\",\"url\":\"https://skatys.com/\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Skatys\",\"item\":\"https://www.outmanelbouhali.online/work/skatys\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"skatys","title":"Skatys","category":"Full Stack Web App","year":"2026","tagline":"The modern freelance marketplace built for speed.","description":"A freelance full-stack platform built with Next.js and Django, containerized with Docker and NGINX on a secure production VPS environment.","overview":"Skatys is a custom-engineered web application combining a hyper-fast Next.js frontend with a robust Django REST backend. Deployed on a Linux VPS using Docker containers and NGINX reverse proxy for high security and performance.","conclusion":"Delivered a production-ready freelance platform with high-speed rendering, seamless API integration, and custom UI components.","thumbnail":{"src":"/images/skatys/skatys lab.png","alt":"Skatys freelance marketplace dashboard preview"},"heroImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys web platform hero desktop showcase"},"coverImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys full-stack platform overview screenshot"},"images":[{"src":"/images/skatys/skatys website .png","alt":"Skatys desktop marketplace interface"},{"src":"/images/skatys/skatys website.png","alt":"Skatys freelance project discovery view"},{"src":"/images/skatys/skatys website mobile 3.png","alt":"Skatys mobile responsive client view"},{"src":"/images/skatys/skatys website mobile 1.png","alt":"Skatys mobile job bidding view"}],"services":["Web Architecture","Next.js Frontend","Django API","Docker VPS Setup"],"client":"Skatys Inc.","website":"https://skatys.com/","tags":["Freelance","Next.js","Django","Docker","PostgreSQL"],"serviceSlugs":["web-application-development","django-python-development"],"link":"https://skatys.com/","quote":"An exceptional team that transformed our vision into a high-performance platform. Delivered beyond expectations.","quoteAuthor":"Skatys Inc.","quoteRole":"Product Owner","credits":[{"role":"Full Stack Development","name":"Outman El Bouhali"},{"role":"Architecture & DevOps","name":"Outman El Bouhali"},{"role":"UI/UX Design","name":"Outman El Bouhali"}]},"nextProject":{"slug":"revo","title":"Revo","category":"React Web Application","year":"2025","tagline":"A modern web experience built with React.","description":"A responsive web application built with React.js, focused on modern UI, reusable components, and a smooth user experience.","overview":"Revo is a modern web application developed with React.js. The project focuses on building a responsive and scalable frontend architecture using reusable components, clean UI patterns, and optimized rendering for a smooth experience across different screen sizes.","conclusion":"Delivered a responsive React.js web application with a reusable component architecture, polished interface, and strong focus on performance and user experience.","thumbnail":{"src":"/images/revo/revo lab.png","alt":"Revo application user interface laboratory thumbnail"},"heroImage":{"src":"/images/revo/revo thumbnail.jpeg","alt":"Revo React application showcase hero"},"coverImage":{"src":"/images/revo/revo4.jpeg","alt":"Revo responsive layouts and interactive cards"},"images":[{"src":"/images/revo/revo.jpeg","alt":"Revo frontend typography and design system"},{"src":"/images/revo/revoo.jpeg","alt":"Revo interactive dashboard view"}],"services":["React Development","Frontend Architecture","Responsive UI","UI/UX Implementation"],"client":"Revo","website":"https://revo.com","tags":["React.js","JavaScript","Frontend","Responsive Design"],"serviceSlugs":["web-application-development"],"link":"https://github.com/oelbouha/Revo","quote":"Engineered with a modular component architecture focused on smooth UI state transitions, clean rendering patterns, and high-performance cross-device layout flexibility.","quoteAuthor":"Architecture Note","quoteRole":"Frontend Design & Technical Highlights","credits":[{"role":"Frontend Development","name":"Outman El Bouhali"},{"role":"React Architecture","name":"Outman El Bouhali"},{"role":"UI/UX Implementation","name":"Outman El Bouhali"}]}}]]

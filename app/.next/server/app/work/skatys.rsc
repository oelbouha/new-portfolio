10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Skatys\",\"headline\":\"A modern digital presence for an SAP and digital transformation company.\",\"description\":\"SKATYS is a corporate web platform developed to establish and strengthen the company’s digital presence. The website presents the company’s identity, expertise, business solutions, and services while providing an Insights & News section for sharing industry knowledge and company updates. Built with Next.js and Django, the platform combines a modern frontend with a structured backend architecture, supported by PostgreSQL and Docker-based deployment on a production VPS.\",\"applicationCategory\":\"Full-Stack Corporate Website\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/skatys/Skatys Website .png\",\"url\":\"https://skatys.com/\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Skatys\",\"item\":\"https://www.outmanelbouhali.online/work/skatys\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"skatys","title":"Skatys","category":"Full-Stack Corporate Website","year":"2026","tagline":"A modern digital presence for an SAP and digital transformation company.","description":"A full-stack corporate website developed for SKATYS Inc., presenting the company, its expertise, SAP solutions, services, and industry insights through a modern digital experience.","overview":"SKATYS is a corporate web platform developed to establish and strengthen the company’s digital presence. The website presents the company’s identity, expertise, business solutions, and services while providing an Insights & News section for sharing industry knowledge and company updates. Built with Next.js and Django, the platform combines a modern frontend with a structured backend architecture, supported by PostgreSQL and Docker-based deployment on a production VPS.","conclusion":"Delivered a full-stack corporate website combining company presentation, business solution showcases, content sections, and production infrastructure.","thumbnail":{"src":"/images/skatys/skatys lab.png","alt":"Skatys project thumbnail"},"heroImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys project hero preview"},"coverImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys project showcase"},"images":[{"src":"/images/skatys/skatys website .png","alt":"Skatys project showcase image 1"},{"src":"/images/skatys/skatys website.png","alt":"Skatys project showcase image 2"},{"src":"/images/skatys/skatys website mobile 3.png","alt":"Skatys project showcase image 3"},{"src":"/images/skatys/skatys website mobile 1.png","alt":"Skatys project showcase image 4"}],"services":["Corporate Website Development","Full-Stack Development","Next.js Frontend","Django Backend & API","Content & Insights Presentation","Docker VPS Deployment"],"serviceSlugs":["web-application-development","django-python-development"],"client":"Skatys Inc.","website":"https://skatys.com/","tags":["Next.js","Django","Python","PostgreSQL","Docker","Corporate Website","Full Stack"],"link":"https://skatys.com/","quote":"A modern corporate digital platform connecting company information, business solutions, and industry insights through a full-stack architecture.","quoteAuthor":"Project Highlights","quoteRole":"Full-Stack Development"},"nextProject":{"slug":"atlas","title":"Sahara Flora","category":"Cross-Platform Mobile Application","year":"2026","tagline":"A unified Flutter application across mobile and Android TV.","description":"A cross-platform application developed with Flutter and Dart, designed to deliver an adaptive experience across Android smartphones and TV devices.","overview":"Sahara Flora is a cross-platform application developed using Flutter and Dart. The project focuses on a shared application architecture that adapts to different Android environments, including smartphones and television screens. It emphasizes responsive layouts, reusable components, and adaptive interfaces for different screen sizes and interaction methods.","conclusion":"Developed a unified Flutter application architecture supporting mobile and Android TV experiences through a shared codebase.","thumbnail":{"src":"/images/atlas/atlas book thumbanil.jpeg","alt":"Sahara Flora project thumbnail"},"heroImage":{"src":"/images/atlas/atlass.jpeg","alt":"Sahara Flora project hero preview"},"coverImage":{"src":"/images/atlas/atlass.jpeg","alt":"Sahara Flora project showcase"},"images":[{"src":"/images/atlas/atlass.jpeg","alt":"Sahara Flora project showcase image 1"},{"src":"/images/atlas/atlas 2.jpeg","alt":"Sahara Flora project showcase image 2"},{"src":"/images/atlas/atlas 1.jpeg","alt":"Sahara Flora project showcase image 3"}],"services":["Flutter Development","Dart Development","Android Application Development","Android TV Development","Adaptive UI Architecture","Cross-Platform Engineering"],"serviceSlugs":["flutter-app-development"],"client":"Sahara Flora","website":"","tags":["Flutter","Dart","Android","Android TV","Mobile Development","Cross-Platform"],"link":"","quote":"One unified Flutter codebase designed to adapt to mobile touch interactions and Android TV navigation.","quoteAuthor":"Project Highlights","quoteRole":"Cross-Platform Architecture"}}]]

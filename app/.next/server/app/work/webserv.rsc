10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Webserv\",\"headline\":\"Custom C++ HTTP/1.1 web server from scratch.\",\"description\":\"Developed a fully compliant HTTP/1.1 web server from scratch in C++ without external libraries. Built using poll/epoll socket multiplexing to handle hundreds of concurrent clients simultaneously with non-blocking I/O, custom NGINX-style configuration parsing, static file streaming, and dynamic CGI support.\",\"applicationCategory\":\"Systems Programming\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/webserv.png\",\"url\":\"https://github.com/oelbouha/webserv\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Webserv\",\"item\":\"https://www.outmanelbouhali.online/work/webserv\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"webserv","title":"Webserv","category":"Systems Programming","year":"2024","tagline":"Custom C++ HTTP/1.1 web server from scratch.","description":"Non-blocking I/O multiplexed HTTP/1.1 web server written in C++98 handling concurrent connections, CGI execution, and route management.","overview":"Developed a fully compliant HTTP/1.1 web server from scratch in C++ without external libraries. Built using poll/epoll socket multiplexing to handle hundreds of concurrent clients simultaneously with non-blocking I/O, custom NGINX-style configuration parsing, static file streaming, and dynamic CGI support.","conclusion":"Achieved strict RFC compliance, zero memory leaks, and high-throughput network performance verified through rigorous stress testing.","thumbnail":{"src":"/images/webserv.png","alt":"Webserv project thumbnail"},"heroImage":{"src":"/images/webserv.png","alt":"Webserv project hero preview"},"coverImage":{"src":"/images/webserv.png","alt":"Webserv project showcase"},"images":[{"src":"/images/webserv.png","alt":"Webserv project showcase image 1"},{"src":"/images/webserv2.png","alt":"Webserv project showcase image 2"},{"src":"/images/webserv1.avif","alt":"Webserv project showcase image 3"}],"services":["Systems Programming","C++ Network Architecture","HTTP/1.1 Protocol Engine","CGI Execution Layer"],"serviceSlugs":["web-application-development"],"client":"42 Network / Systems Project","website":"https://github.com/oelbouha/webserv","tags":["C++","HTTP/1.1","Sockets","Network Systems","epoll"],"link":"https://github.com/oelbouha/webserv","quote":"A deeply engineered socket server with meticulous state machines and asynchronous I/O multiplexing.","quoteAuthor":"Systems Review","quoteRole":"Core Network Engineering"},"nextProject":{"slug":"workflow-automation","title":"Workflow Hub","category":"Automation Pipelines","year":"2025","tagline":"n8n & Make custom integration pipelines.","description":"Enterprise automation pipeline connecting multiple SaaS tools, webhooks, and AI agents for workflow optimization.","overview":"Constructed scalable automation architectures using self-hosted n8n instances and Make. Built custom webhooks, data transformation scripts, error recovery loops, and AI-powered categorization pipelines to automate routine business workflows.","conclusion":"Saved hundreds of operational hours per month by bridging CRM, billing, messaging, and database updates seamlessly.","thumbnail":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"Workflow Hub project thumbnail"},"heroImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"Workflow Hub project hero preview"},"coverImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"Workflow Hub project showcase"},"images":[{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"Workflow Hub project showcase image 1"},{"src":"/images/n8n/automation.png","alt":"Workflow Hub project showcase image 2"},{"src":"/images/n8n/automation .png","alt":"Workflow Hub project showcase image 3"}],"services":["n8n Architecture","API & Webhook Integrations","Data Transformation","Workflow Optimization"],"serviceSlugs":["n8n-automation"],"client":"Internal & Client Systems","website":"","tags":["n8n","Automation","Webhooks","REST APIs","Pipelines"],"link":"","quote":"Turned complex multi-tool operational headaches into reliable, zero-touch background automation.","quoteAuthor":"Automation Engineering","quoteRole":"Integration Systems"}}]]

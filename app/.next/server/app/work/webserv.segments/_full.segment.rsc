10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Webserv\",\"headline\":\"Custom C++ HTTP/1.1 web server from scratch.\",\"description\":\"Developed a fully compliant HTTP/1.1 web server from scratch in C++ without external libraries. Built using poll/epoll socket multiplexing to handle hundreds of concurrent clients simultaneously with non-blocking I/O, custom NGINX-style configuration parsing, static file streaming, and dynamic CGI support.\",\"applicationCategory\":\"Systems Programming\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/webserv.png\",\"url\":\"https://github.com/oelbouha/webserv\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Webserv\",\"item\":\"https://www.outmanelbouhali.online/work/webserv\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"webserv","title":"Webserv","category":"Systems Programming","year":"2024","tagline":"Custom C++ HTTP/1.1 web server from scratch.","description":"Non-blocking I/O multiplexed HTTP/1.1 web server written in C++98 handling concurrent connections, CGI execution, and route management.","overview":"Developed a fully compliant HTTP/1.1 web server from scratch in C++ without external libraries. Built using poll/epoll socket multiplexing to handle hundreds of concurrent clients simultaneously with non-blocking I/O, custom NGINX-style configuration parsing, static file streaming, and dynamic CGI support.","conclusion":"Achieved strict RFC compliance, zero memory leaks, and high-throughput network performance verified through rigorous stress testing.","thumbnail":{"src":"/images/webserv.png","alt":"Webserv custom C++ HTTP server terminal preview"},"heroImage":{"src":"/images/webserv.png","alt":"Webserv architecture socket multiplexing diagram"},"coverImage":{"src":"/images/webserv.png","alt":"Webserv server configuration parser showcase"},"images":[{"src":"/images/webserv.png","alt":"Webserv terminal execution output"},{"src":"/images/webserv2.png","alt":"Webserv concurrent client stress test results"},{"src":"/images/webserv1.avif","alt":"Webserv CGI environment handling demonstration"}],"services":["Systems Programming","C++ Network Architecture","HTTP/1.1 Protocol Engine","CGI Execution Layer"],"client":"42 Network / Systems Project","website":"https://github.com/oelbouha/webserv","tags":["C++","HTTP/1.1","Sockets","Network Systems","epoll"],"serviceSlugs":["django-python-development","web-application-development"],"link":"https://github.com/oelbouha/webserv","quote":"A deeply engineered socket server with meticulous state machines and asynchronous I/O multiplexing.","quoteAuthor":"Systems Review","quoteRole":"Core Network Engineering","credits":[{"role":"Lead Systems Developer","name":"Outman El Bouhali"}]},"nextProject":{"slug":"skatys","title":"Skatys","category":"Full Stack Web App","year":"2026","tagline":"The modern freelance marketplace built for speed.","description":"A freelance full-stack platform built with Next.js and Django, containerized with Docker and NGINX on a secure production VPS environment.","overview":"Skatys is a custom-engineered web application combining a hyper-fast Next.js frontend with a robust Django REST backend. Deployed on a Linux VPS using Docker containers and NGINX reverse proxy for high security and performance.","conclusion":"Delivered a production-ready freelance platform with high-speed rendering, seamless API integration, and custom UI components.","thumbnail":{"src":"/images/skatys/skatys lab.png","alt":"Skatys freelance marketplace dashboard preview"},"heroImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys web platform hero desktop showcase"},"coverImage":{"src":"/images/skatys/Skatys Website .png","alt":"Skatys full-stack platform overview screenshot"},"images":[{"src":"/images/skatys/skatys website .png","alt":"Skatys desktop marketplace interface"},{"src":"/images/skatys/skatys website.png","alt":"Skatys freelance project discovery view"},{"src":"/images/skatys/skatys website mobile 3.png","alt":"Skatys mobile responsive client view"},{"src":"/images/skatys/skatys website mobile 1.png","alt":"Skatys mobile job bidding view"}],"services":["Web Architecture","Next.js Frontend","Django API","Docker VPS Setup"],"client":"Skatys Inc.","website":"https://skatys.com/","tags":["Freelance","Next.js","Django","Docker","PostgreSQL"],"serviceSlugs":["web-application-development","django-python-development"],"link":"https://skatys.com/","quote":"An exceptional team that transformed our vision into a high-performance platform. Delivered beyond expectations.","quoteAuthor":"Skatys Inc.","quoteRole":"Product Owner","credits":[{"role":"Full Stack Development","name":"Outman El Bouhali"},{"role":"Architecture & DevOps","name":"Outman El Bouhali"},{"role":"UI/UX Design","name":"Outman El Bouhali"}]}}]]

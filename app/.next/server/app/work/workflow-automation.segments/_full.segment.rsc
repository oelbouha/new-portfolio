10:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Workflow Hub\",\"headline\":\"n8n & Make custom integration pipelines.\",\"description\":\"Constructed scalable automation architectures using self-hosted n8n instances and Make. Built custom webhooks, data transformation scripts, error recovery loops, and AI-powered categorization pipelines to automate routine business workflows.\",\"applicationCategory\":\"Automation Pipelines\",\"author\":{\"@type\":\"Person\",\"name\":\"Outman Elbouhali\",\"url\":\"https://www.outmanelbouhali.online\"},\"image\":\"https://www.outmanelbouhali.online/images/call-to-action/n8n Automation Workflow .png\",\"url\":\"https://www.outmanelbouhali.online/work/workflow-automation\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.outmanelbouhali.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.outmanelbouhali.online/work\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Workflow Hub\",\"item\":\"https://www.outmanelbouhali.online/work/workflow-automation\"}]}"}}]],["$","$L1f",null,{"project":{"slug":"workflow-automation","title":"Workflow Hub","category":"Automation Pipelines","year":"2025","tagline":"n8n & Make custom integration pipelines.","description":"An enterprise automation pipeline connecting multiple SaaS tools, webhooks, and AI agents for end-to-end operational workflow optimization.","overview":"Constructed scalable automation architectures using self-hosted n8n instances and Make. Built custom webhooks, data transformation scripts, error recovery loops, and AI-powered categorization pipelines to automate routine business workflows.","conclusion":"Saved hundreds of operational hours per month by bridging CRM, billing, messaging, and database updates seamlessly.","thumbnail":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n workflow hub orchestration preview"},"heroImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n automation canvas diagram showing multi-step API connectors"},"coverImage":{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n visual node workflow execution graph"},"images":[{"src":"/images/call-to-action/n8n Automation Workflow .png","alt":"n8n trigger and webhook integration nodes"},{"src":"/images/n8n/automation.png","alt":"Self-hosted n8n workflow execution logs"},{"src":"/images/n8n/automation .png","alt":"AI agent routing node and LLM integration in n8n"}],"services":["n8n Architecture","API & Webhook Integrations","Data Transformation","Workflow Optimization"],"client":"Internal & Client Systems","website":"","tags":["n8n","Automation","Webhooks","REST APIs","Pipelines"],"serviceSlugs":["n8n-automation"],"link":"","quote":"Turned complex multi-tool operational headaches into reliable, zero-touch background automation.","quoteAuthor":"Automation Engineering","quoteRole":"Integration Systems","credits":[{"role":"Automation Architect","name":"Outman El Bouhali"}]},"nextProject":{"slug":"docker-vps","title":"Docker VPS","category":"Cloud & Infrastructure","year":"2025","tagline":"VPS container orchestration & CI/CD deployment.","description":"Production VPS orchestration system leveraging Docker containers, NGINX reverse proxy, automated SSL certificates, and streamlined CI/CD flows.","overview":"Designed and deployed a resilient server infrastructure on a Linux VPS. Isolated services into lightweight Docker containers, configured multi-domain SSL with Let’s Encrypt, and orchestrated automated zero-downtime deployment pipelines with GitHub Actions.","conclusion":"Established high availability, sub-100ms response times, and automated container lifecycle management across production servers.","thumbnail":{"src":"/images/docker.jpeg","alt":"Docker VPS server orchestration preview"},"heroImage":{"src":"/images/docker.jpeg","alt":"Docker containers running in Linux terminal"},"coverImage":{"src":"/images/docker.jpeg","alt":"Linux VPS and NGINX configuration setup"},"images":[{"src":"/images/docker.jpeg","alt":"Docker compose multi-container orchestration"},{"src":"/images/docker1.png","alt":"Docker production containers status"},{"src":"/images/docker2.webp","alt":"NGINX reverse proxy and SSL certificate deployment"},{"src":"/images/docker5.png","alt":"Automated CI/CD deployment logs"}],"services":["Docker Containerization","VPS Hardening","NGINX Reverse Proxy","CI/CD Pipelines"],"client":"Cloud Infrastructure","website":"","tags":["Docker","Linux VPS","NGINX","DevOps","CI/CD"],"serviceSlugs":["django-python-development","n8n-automation"],"link":"","quote":"Robust server hardening and container orchestration that cut deployment friction to zero.","quoteAuthor":"DevOps Architecture","quoteRole":"Infrastructure Highlights","credits":[{"role":"DevOps Engineering","name":"Outman El Bouhali"},{"role":"System Administration","name":"Outman El Bouhali"}]}}]]
